# Razorpay API Configuration (Test Mode)
# Get these from https://dashboard.razorpay.com/ -> Settings -> API Keys
# Enable Test Mode toggle to get test credentials

RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_test_key_secret_here

# Groq API Configuration (for Stage 3 Exception Reasoning)
GROQ_API_KEY=gsk_your_groq_api_key_here
# openai/gpt-oss-120b is the recommended model as of 2026-09-04.
# llama-3.3-70b-versatile was decommissioned by Groq on 2026-08-16.
GROQ_MODEL=openai/gpt-oss-120b
