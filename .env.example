# Razorpay API Configuration (Test Mode) — optional
# Get these from https://dashboard.razorpay.com/ -> Settings -> API Keys
# Enable Test Mode toggle to get test credentials.
# Leave unset to use the bundled synthetic snapshot.

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Groq API Configuration (Stage 3 exception reasoning) — optional
# Business-logic benchmark and --no-llm runs do not require this key.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# API authentication
# Demo/dev default is accepted only when ENV=development and DEMO_MODE=true.
# Production (ENV=production or DEMO_MODE=false) refuses the default key.
API_SECRET_KEY=dev-secret-key
ENV=development
DEMO_MODE=true
